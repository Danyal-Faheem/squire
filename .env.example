# SPDX-License-Identifier: AGPL-3.0-or-later
# Squire configuration. Copy to `.env` and fill in real values.
# Nothing in the codebase reads os.environ directly; everything goes through
# squire.common.config.Settings, which loads this file.
#
# This file holds the environment tier of configuration: secrets and
# infrastructure that are identical across deployments. Project-specific
# configuration lives in a deployment directory under deployments/.

# --- LLM / inference (any OpenAI-compatible endpoint) -------------------------
# Point these at whatever serves the model — a self-hosted inference server or a
# cloud provider. Only the OpenAI-compatible protocol is assumed; switching
# providers is just a matter of changing these values.
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed                  # set to your provider's key when needed
GENERATION_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct

# Embeddings may be served by a different endpoint/provider than generation.
# Note: EMBEDDING_DIM is baked into the database schema. You may swap embedding
# models freely at the same dimension; a different dimension needs a migration.
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=not-needed
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Database -----------------------------------------------------------------
# Postgres DSN. The image must have the pgvector extension (we use pgvector/pgvector).
DATABASE_URL=postgresql+psycopg://squire:squire@localhost:5432/squire

# --- Deployment selection -----------------------------------------------------
# Which directory under deployments/ holds this instance's project-specific config.
SQUIRE_DEPLOYMENT=example

# --- Board credentials (default board backend: GitHub) ------------------------
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=                      # PEM contents (or a path your code reads)
GITHUB_WEBHOOK_SECRET=

# --- Messaging credentials (default adapter: Slack) ---------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
MESSAGING_DIGEST_CHANNEL=
MESSAGING_DIGEST_CRON=0 9 * * MON        # APScheduler cron: Mondays at 09:00

# --- Commands / agent ---------------------------------------------------------
AGENT_PR_KEYWORD=open-pr
BOT_MENTION_HANDLE=@squire

# --- Feature flags (all default off / safe) -----------------------------------
AUTOPR_ENABLED=false                     # the coding agent may open draft PRs
SOURCE_WRITE_ENABLED=false               # adapters may write back to sources
DRY_RUN=true                             # log intended writes instead of doing them
